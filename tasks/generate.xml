    <path id="org.example.uml2cs.classpath">
        <path refid="org.example.uml2cs.libraryclasspath"/>
    </path>

    <!-- The classpath with only the jars available in the plugin folder of Eclipse -->
    <path id="org.example.uml2cs.libraryclasspath.alljars">
        <pathelement location="../org.example.uml2cs/bin"/>
        <fileset dir="${ECLIPSE_HOME}/plugins/" includes="*.jar"/>
    </path>

    <path id="org.example.uml2cs.classpath.alljars">
        <path refid="org.example.uml2cs.libraryclasspath.alljars"/>
    </path>

    <!-- The default task with the jars used by this project -->
    <target name="generate">
        <java classname="org.example.uml2cs.main.Generate" classpathref="org.example.uml2cs.classpath">
            <arg value="${model}"/>
            <arg value="${target}"/>
        </java>
    </target>

    <!--
        In case of problem you can also try with all the jar available in your Eclipse
        Keep in mind that having two versions of the same jar can create problems
    -->
    <target name="generate.alljars">
        <java classname="org.example.uml2cs.main.Generate" classpathref="org.example.uml2cs.classpath">
            <arg value="${model}"/>
            <arg value="${target}"/>
        </java>
    </target>
